APP_NAME="Hospital Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="UTC"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Database Configuration (PostgreSQL 16+)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hms_master
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# Redis Configuration (Cache, Sessions, Queues)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=1
REDIS_DB_SESSION=2

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Queue Driver (Horizon / Redis)
QUEUE_CONNECTION=redis
HORIZON_PREFIX=hms_horizon:

# File Storage Driver (AWS S3 or Local MinIO)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hms-clinical-docs
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Telegram Bot API Reporting & Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORTING_CHAT_ID=
TELEGRAM_CRITICAL_ALERT_CHAT_ID=
TELEGRAM_BOT_ENABLED=true

# Sanctum Authentication & CORS
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"
SESSION_DOMAIN=localhost

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@hms.hospital.internal"
MAIL_FROM_NAME="${APP_NAME}"
